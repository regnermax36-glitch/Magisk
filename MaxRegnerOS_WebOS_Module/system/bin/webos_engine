#!/system/bin/sh

##########################################################################################
# MaxRegnerOS WebOS Engine v1.1
# Ultra-lightweight web browser engine for Samsung Galaxy Z Flip5
##########################################################################################

export WEBOS_VERSION="1.1"
export WEBOS_DEVICE="b5q"
export WEBOS_HOME="/data/maxregner_webos"

# Web engine configuration
WEBVIEW_PACKAGE="com.android.webview"
USER_AGENT="MaxRegnerOS/1.1 (Samsung Galaxy Z Flip5; Android $(getprop ro.build.version.release))"
CACHE_DIR="/data/maxregner_webos/cache"
DATA_DIR="/data/maxregner_webos/data"

# Create directories if they don't exist
mkdir -p "$CACHE_DIR"
mkdir -p "$DATA_DIR"

# Function to start web engine
start_webengine() {
    echo "Starting MaxRegnerOS WebOS Engine v1.1..."
    
    # Set web engine properties
    setprop webview.multiprocess.enabled true
    setprop webview.enable_safebrowsing false
    setprop webview.enable_crash_reporting false
    
    # Configure memory limits
    setprop dalvik.vm.heapsize 512m
    setprop dalvik.vm.heapgrowthlimit 256m
    setprop dalvik.vm.heapmaxfree 8m
    setprop dalvik.vm.heapminfree 2m
    
    # Start chromium webview process
    exec /system/bin/chromium_webview "$@"
}

# Function to clear cache
clear_cache() {
    echo "Clearing web cache..."
    rm -rf "$CACHE_DIR"/*
    mkdir -p "$CACHE_DIR"
    echo "Cache cleared successfully"
}

# Function to reset web engine
reset_engine() {
    echo "Resetting web engine..."
    clear_cache
    rm -rf "$DATA_DIR"/*
    mkdir -p "$DATA_DIR"
    echo "Web engine reset successfully"
}

# Main execution
case "$1" in
    "start")
        start_webengine "${@:2}"
        ;;
    "clear-cache")
        clear_cache
        ;;
    "reset")
        reset_engine
        ;;
    *)
        start_webengine "$@"
        ;;
esac

